rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // User documents can be read by their owner. All writes are server-side only.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Pass records are read-only to the owning passenger. Cloud Functions use Admin SDK.
    match /passes/{passId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
